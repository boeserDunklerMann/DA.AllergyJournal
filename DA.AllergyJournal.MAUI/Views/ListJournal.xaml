<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DA.AllergyJournal.MAUI.MVVM"
			 xmlns:model="clr-namespace:DA.AllergyJournal.Model;assembly=DA.AllergyJournal.Model"
			 xmlns:conv="clr-namespace:DA.AllergyJournal.MAUI.Converters"
			 x:DataType="vm:ListJournalVM"
			 x:Class="DA.AllergyJournal.MAUI.Views.ListJournal"
			 Title="Dein Tagebuch"
			 BackgroundColor="{StaticResource AppBackground}">

	<!-- Farben (App*) zentral in Resources/Styles/Colors.xaml -->
	<ContentPage.Resources>
		<conv:LevelOfPainToTextConverter x:Key="LevelOfPainToText" />
		<conv:WeatherToImageConverter x:Key="WeatherToImage" />

		<!-- Beschriftung eines Symptoms (Nase, Augen, ...) -->
		<Style x:Key="SymptomCaption" TargetType="Label">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="TextColor" Value="{StaticResource AppTextSecondary}" />
			<Setter Property="HorizontalTextAlignment" Value="Center" />
		</Style>
		<!-- Wert-Badge eines Symptoms, wie die "x / 3"-Anzeige der SymptomPage -->
		<Style x:Key="SymptomBadge" TargetType="Border">
			<Setter Property="BackgroundColor" Value="{StaticResource AppBadgeBackground}" />
			<Setter Property="StrokeThickness" Value="0" />
			<Setter Property="StrokeShape" Value="RoundRectangle 8" />
			<Setter Property="Padding" Value="6,4" />
		</Style>
		<Style x:Key="SymptomValue" TargetType="Label">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="TextColor" Value="{StaticResource AppBadgeText}" />
			<Setter Property="HorizontalTextAlignment" Value="Center" />
		</Style>
	</ContentPage.Resources>

	<ContentPage.ToolbarItems>
		<ToolbarItem Text="Neu"
                     Command="{Binding NeuesElementHinzufuegenCommand}"
                     Order="Primary"
                     Priority="0" />
	</ContentPage.ToolbarItems>

	<!-- Nach unten ziehen lädt die Einträge neu -->
	<RefreshView IsRefreshing="{Binding WirdGeladen, Mode=TwoWay}"
                 Command="{Binding AktualisierenCommand}"
                 RefreshColor="{StaticResource AppAccent}">
		<CollectionView ItemsSource="{Binding Dailies}"
                        SelectionMode="None"
                        Margin="20,16,20,16">
			<CollectionView.ItemsLayout>
				<LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="14" />
			</CollectionView.ItemsLayout>

			<CollectionView.EmptyView>
				<VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="10"
                                     Padding="32">
					<Label Text="Noch keine Einträge"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AppText}"
                           HorizontalTextAlignment="Center" />
					<Label Text="Erfasse deinen ersten Tag über „Neu“."
                           FontSize="13"
                           TextColor="{StaticResource AppTextSecondary}"
                           HorizontalTextAlignment="Center" />
					<Button Text="Neuer Eintrag"
                            Command="{Binding NeuesElementHinzufuegenCommand}"
                            BackgroundColor="{StaticResource AppAccent}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="46"
                            Padding="16,0" />
				</VerticalStackLayout>
			</CollectionView.EmptyView>

			<!-- Ein Tageseintrag: Datum, vier Symptome, Wetter, Medikamente -->
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="model:DailyJournalEntry">
					<Border BackgroundColor="{StaticResource AppSurface}"
                            Stroke="{StaticResource AppBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="16">
						<Grid ColumnDefinitions="*, *, *, *, *"
                              RowDefinitions="Auto, Auto, Auto, Auto"
                              ColumnSpacing="8"
                              RowSpacing="4">

							<Label Grid.Row="0" Grid.ColumnSpan="5"
                                   Text="{Binding StoredDate, StringFormat='{0:dddd, dd.MM.yyyy}'}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   Margin="0,0,0,8"
                                   TextColor="{StaticResource AppText}" />

							<Label Grid.Row="1" Grid.Column="0" Text="Nase" Style="{StaticResource SymptomCaption}" />
							<Label Grid.Row="1" Grid.Column="1" Text="Augen" Style="{StaticResource SymptomCaption}" />
							<Label Grid.Row="1" Grid.Column="2" Text="Lunge" Style="{StaticResource SymptomCaption}" />
							<Label Grid.Row="1" Grid.Column="3" Text="Haut" Style="{StaticResource SymptomCaption}" />
							<Label Grid.Row="1" Grid.Column="4" Text="Wetter" Style="{StaticResource SymptomCaption}" />

							<Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SymptomBadge}">
								<Label Text="{Binding Nose, Converter={StaticResource LevelOfPainToText}}" Style="{StaticResource SymptomValue}" />
							</Border>
							<Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SymptomBadge}">
								<Label Text="{Binding Eyes, Converter={StaticResource LevelOfPainToText}}" Style="{StaticResource SymptomValue}" />
							</Border>
							<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SymptomBadge}">
								<Label Text="{Binding Lung, Converter={StaticResource LevelOfPainToText}}" Style="{StaticResource SymptomValue}" />
							</Border>
							<Border Grid.Row="2" Grid.Column="3" Style="{StaticResource SymptomBadge}">
								<Label Text="{Binding Skin, Converter={StaticResource LevelOfPainToText}}" Style="{StaticResource SymptomValue}" />
							</Border>
							<Border Grid.Row="2" Grid.Column="4" Style="{StaticResource SymptomBadge}" Padding="6,1">
								<Image Source="{Binding Weather, Converter={StaticResource WeatherToImage}}"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       SemanticProperties.Description="Wetter" />
							</Border>

							<Label Grid.Row="3" Grid.ColumnSpan="5"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{StaticResource AppTextSecondary}">
								<Label.FormattedText>
									<FormattedString>
										<Span Text="Medikamente: " />
										<Span Text="{Binding Medicine, TargetNullValue='keine'}" />
									</FormattedString>
								</Label.FormattedText>
							</Label>
						</Grid>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</RefreshView>
</ContentPage>
