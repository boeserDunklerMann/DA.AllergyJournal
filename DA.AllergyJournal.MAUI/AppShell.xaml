<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DA.AllergyJournal.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DA.AllergyJournal.MAUI"
	xmlns:views="clr-namespace:DA.AllergyJournal.MAUI.Views"
    Title="DA.AllergyJournal.MAUI"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False">

    <!-- Navigation erfolgt über das Hamburger-Menü (Views/AppMenu.cs) -->
    <TabBar>
        <ShellContent
            Title="Erfassen"
            ContentTemplate="{DataTemplate views:SymptomPage}"
            Route="SymptomPage" />
        <ShellContent
            Title="Übersicht"
            ContentTemplate="{DataTemplate views:ListJournal}"
            Route="ListJournal" />
    </TabBar>

</Shell>
