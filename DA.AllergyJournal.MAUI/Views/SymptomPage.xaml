<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DA.AllergyJournal.MAUI.MVVM"
             x:DataType="vm:SymptomViewVM"
			 x:Class="DA.AllergyJournal.MAUI.Views.SymptomPage"
             Title="Allergietagebuch"
             BackgroundColor="{StaticResource AppBackground}">

	<ScrollView>
		<VerticalStackLayout Padding="20,24" Spacing="14">
			<VerticalStackLayout Spacing="4" Margin="0,0,0,6">
				<Label Text="Symptom-Erfassung"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource AppText}" />
				<Label Text="Bewerten Sie die Intensität je Bereich von 0 (keine) bis 3 (stark)."
                       FontSize="14"
                       TextColor="{StaticResource AppTextSecondary}" />
			</VerticalStackLayout>

			<!-- Datum -->
			<Border BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,12">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<Label Grid.Column="0"
                           Text="Datum"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AppText}"
                           VerticalOptions="Center" />
					<DatePicker Grid.Column="1"
                                Format="dd.MM.yyyy"
                                TextColor="{StaticResource AppText}"
                                VerticalOptions="Center" Date="{Binding DateWert, Mode=TwoWay}" />
				</Grid>
			</Border>

			<!-- Nase -->
			<Border BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
				<VerticalStackLayout Spacing="10">
					<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
						<VerticalStackLayout Grid.Column="0" Spacing="2">
							<Label Text="Nase"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
							<Label Text="Niesen, Juckreiz, Naselaufen oder Verstopfung"
                                   FontSize="12"
                                   TextColor="{StaticResource AppTextSecondary}" />
						</VerticalStackLayout>
						<Border Grid.Column="1"
                                BackgroundColor="{StaticResource AppBadgeBackground}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,5"
                                VerticalOptions="Center">
							<Label Text="{Binding NaseWert, StringFormat='{0:F0} / 3'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppBadgeText}" />
						</Border>
					</Grid>

					<Slider Minimum="0"
                            Maximum="3"
                            Value="{Binding NaseWert, Mode=TwoWay}"
                            MinimumTrackColor="{StaticResource AppAccent}"
                            MaximumTrackColor="{StaticResource AppBorder}"
                            ThumbColor="{StaticResource AppAccent}" />
					<Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
						<Label Grid.Column="0" Text="0 · Keine" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Start" />
						<Label Grid.Column="1" Text="1 · Leicht" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Center" />
						<Label Grid.Column="2" Text="2 · Mäßig" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Center" />
						<Label Grid.Column="3" Text="3 · Stark" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="End" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<!-- Augen -->
			<Border BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
				<VerticalStackLayout Spacing="10">
					<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
						<VerticalStackLayout Grid.Column="0" Spacing="2">
							<Label Text="Augen"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
							<Label Text="Rötung, Tränenfluss oder Juckreiz"
                                   FontSize="12"
                                   TextColor="{StaticResource AppTextSecondary}" />
						</VerticalStackLayout>
						<Border Grid.Column="1"
                                BackgroundColor="{StaticResource AppBadgeBackground}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,5"
                                VerticalOptions="Center">
							<Label Text="{Binding AugenWert, StringFormat='{0:F0} / 3'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppBadgeText}" />
						</Border>
					</Grid>

					<Slider Minimum="0"
                            Maximum="3"
                            Value="{Binding AugenWert, Mode=TwoWay}"
                            MinimumTrackColor="{StaticResource AppAccent}"
                            MaximumTrackColor="{StaticResource AppBorder}"
                            ThumbColor="{StaticResource AppAccent}" />
					<Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
						<Label Grid.Column="0" Text="0 · Keine" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Start" />
						<Label Grid.Column="1" Text="1 · Leicht" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Center" />
						<Label Grid.Column="2" Text="2 · Mäßig" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Center" />
						<Label Grid.Column="3" Text="3 · Stark" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="End" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<!-- Lunge -->
			<Border BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
				<VerticalStackLayout Spacing="10">
					<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
						<VerticalStackLayout Grid.Column="0" Spacing="2">
							<Label Text="Lunge"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
							<Label Text="Husten, Giemen oder Kurzatmigkeit"
                                   FontSize="12"
                                   TextColor="{StaticResource AppTextSecondary}" />
						</VerticalStackLayout>
						<Border Grid.Column="1"
                                BackgroundColor="{StaticResource AppBadgeBackground}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,5"
                                VerticalOptions="Center">
							<Label Text="{Binding LungeWert, StringFormat='{0:F0} / 3'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppBadgeText}" />
						</Border>
					</Grid>

					<Slider Minimum="0"
                            Maximum="3"
                            Value="{Binding LungeWert, Mode=TwoWay}"
                            MinimumTrackColor="{StaticResource AppAccent}"
                            MaximumTrackColor="{StaticResource AppBorder}"
                            ThumbColor="{StaticResource AppAccent}" />
					<Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
						<Label Grid.Column="0" Text="0 · Keine" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Start" />
						<Label Grid.Column="1" Text="1 · Leicht" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Center" />
						<Label Grid.Column="2" Text="2 · Mäßig" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Center" />
						<Label Grid.Column="3" Text="3 · Stark" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="End" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<!-- Haut -->
			<Border BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
				<VerticalStackLayout Spacing="10">
					<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
						<VerticalStackLayout Grid.Column="0" Spacing="2">
							<Label Text="Haut"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppText}" />
							<Label Text="Rötung, Quaddeln, Trockenheit oder Juckreiz"
                                   FontSize="12"
                                   TextColor="{StaticResource AppTextSecondary}" />
						</VerticalStackLayout>
						<Border Grid.Column="1"
                                BackgroundColor="{StaticResource AppBadgeBackground}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,5"
                                VerticalOptions="Center">
							<Label Text="{Binding HautWert, StringFormat='{0:F0} / 3'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AppBadgeText}" />
						</Border>
					</Grid>

					<Slider Minimum="0"
                            Maximum="3"
                            Value="{Binding HautWert, Mode=TwoWay}"
                            MinimumTrackColor="{StaticResource AppAccent}"
                            MaximumTrackColor="{StaticResource AppBorder}"
                            ThumbColor="{StaticResource AppAccent}" />
					<Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
						<Label Grid.Column="0" Text="0 · Keine" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Start" />
						<Label Grid.Column="1" Text="1 · Leicht" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Center" />
						<Label Grid.Column="2" Text="2 · Mäßig" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Center" />
						<Label Grid.Column="3" Text="3 · Stark" FontSize="11" TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="End" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<!-- Wetter -->
			<Border BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
				<VerticalStackLayout Spacing="10">
					<VerticalStackLayout Spacing="2">
						<Label Text="Wetter"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AppText}" />
						<Label Text="Wie war das Wetter an diesem Tag?"
                               FontSize="12"
                               TextColor="{StaticResource AppTextSecondary}" />
					</VerticalStackLayout>

					<CollectionView ItemsSource="{Binding WetterOptionen}"
                                    SelectedItem="{Binding WetterWert, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    HeightRequest="104">
						<CollectionView.ItemsLayout>
							<GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" />
						</CollectionView.ItemsLayout>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="vm:WeatherOption">
								<Border BackgroundColor="{StaticResource AppBackground}"
                                        Stroke="{StaticResource AppBorder}"
                                        StrokeThickness="2"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8">
									<VisualStateManager.VisualStateGroups>
										<VisualStateGroup Name="CommonStates">
											<VisualState Name="Normal" />
											<VisualState Name="Selected">
												<VisualState.Setters>
													<Setter Property="Stroke" Value="{StaticResource AppAccent}" />
													<Setter Property="BackgroundColor" Value="{StaticResource AppBadgeBackground}" />
												</VisualState.Setters>
											</VisualState>
										</VisualStateGroup>
									</VisualStateManager.VisualStateGroups>
									<VerticalStackLayout Spacing="4" HorizontalOptions="Center">
										<Image Source="{Binding Image}"
                                               WidthRequest="48"
                                               HeightRequest="48"
                                               SemanticProperties.Description="{Binding Text}" />
										<Label Text="{Binding Text}"
                                               FontSize="12"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource AppText}" />
									</VerticalStackLayout>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</VerticalStackLayout>
			</Border>

			<!-- Medikamente -->
			<Border BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
				<VerticalStackLayout Spacing="10">
					<VerticalStackLayout Spacing="2">
						<Label Text="Medikamente"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AppText}" />
						<Label Text="Welche Medikamente haben Sie eingenommen?"
                               FontSize="12"
                               TextColor="{StaticResource AppTextSecondary}" />
					</VerticalStackLayout>

					<Border BackgroundColor="{StaticResource AppBackground}"
                            Stroke="{StaticResource AppBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,0">
						<Entry Text="{Binding MedikamenteWert, Mode=TwoWay}"
                               Placeholder="z. B. Cetirizin 10 mg"
                               PlaceholderColor="{StaticResource AppTextSecondary}"
                               TextColor="{StaticResource AppText}"
                               FontSize="14"
                               ClearButtonVisibility="WhileEditing"
                               SemanticProperties.Description="Medikamente" />
					</Border>
				</VerticalStackLayout>
			</Border>

			<!-- Gesamtübersicht & Aktionen -->
			<Border BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
				<VerticalStackLayout Spacing="14">
					<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
						<Label Grid.Column="0"
                               Text="Gesamtscore"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AppText}"
                               VerticalOptions="Center" />
						<Label Grid.Column="1"
                               Text="{Binding GesamtScore, StringFormat='{0} / 12'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AppAccent}"
                               VerticalOptions="Center" />
					</Grid>

					<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
						<Button Grid.Column="0"
                                Text="Zurücksetzen"
                                BackgroundColor="{StaticResource AppBorder}"
                                TextColor="{StaticResource AppButtonSecondaryText}"
                                CornerRadius="10"
                                HeightRequest="46"
                                FontAttributes="Bold"
                                Command="{Binding ResetCommand}" />
						<Button Grid.Column="1"
                                Text="Speichern"
                                BackgroundColor="{StaticResource AppAccent}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10"
                                HeightRequest="46"
                                FontAttributes="Bold"
                                Command="{Binding SaveCommand}" />
					</Grid>
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>