<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DA.AllergyJournal.MAUI.Proto"
             xmlns:conv="clr-namespace:DA.AllergyJournal.MAUI.Proto.Converters"
             x:Class="DA.AllergyJournal.MAUI.Proto.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter -->
            <conv:LevelOfPainToTextConverter x:Key="LevelOfPainToText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
